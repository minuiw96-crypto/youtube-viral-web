# Azure 관리자에게 승인받은 로컬 개발용 값만 입력하세요.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=PASTE_APPROVED_KEY_HERE
AZURE_OPENAI_CHAT_DEPLOYMENT=ytv-predict-gpt
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=ytv-text-embedding

# Supabase Project Settings > API Keys에서 확인합니다.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# 백엔드 전용입니다. Git이나 프론트엔드에 넣지 마세요.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_PROFILES_TABLE=user_profiles
SUPABASE_RAG_TABLE=rag_documents
