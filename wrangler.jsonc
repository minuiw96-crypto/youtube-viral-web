{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youtube-viral-web",
  "compatibility_date": "2026-08-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
